# Store backend: local (no Docker) or docker (Neo4j + Qdrant)
ENGRAM_STORE=local

# Neo4j (used when ENGRAM_STORE=docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=engramdev

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=engram_artifacts

# OpenAI embeddings (leave empty to use local hash embeddings)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=engram-v1
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional: GitHub ingestion (server-side; public demo does not accept browser PATs)
GITHUB_TOKEN=

# Hosted Try (public demo). Leave commented for local builder mode.
# ENGRAM_PUBLIC_MODE=true
# ENGRAM_SEED_ON_BOOT=true
# ENGRAM_PUBLIC_INGEST_LIMIT=30
# ENGRAM_CORS_ORIGINS=https://your-vercel-app.vercel.app
